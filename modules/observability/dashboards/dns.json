{
  "uid": "dns",
  "title": "DNS",
  "tags": [
    "dns"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Blocky and Unbound, with the query log (ticket #164).",
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "dns-querylog"
        },
        "query": "select distinct client_name from log_entries order by 1",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queries per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(blocky_query_total[5m]))",
          "legendFormat": "Blocky",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "description": "Lookups Blocky receives from the LAN.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Share blocked",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(blocky_response_total{response_type=\"BLOCKED\"}[5m])) / sum(rate(blocky_response_total[5m]))",
          "legendFormat": "blocked",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(blocky_cache_hits_total[5m])) / (sum(rate(blocky_cache_hits_total[5m])) + sum(rate(blocky_cache_misses_total[5m])))",
          "legendFormat": "Blocky",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(unbound_cache_hits_total[5m])) / (sum(rate(unbound_cache_hits_total[5m])) + sum(rate(unbound_cache_misses_total[5m])))",
          "legendFormat": "Unbound",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Upstream response time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(blocky_request_duration_seconds_bucket{reason=\"RESOLVED\"}[5m])))",
          "legendFormat": "Blocky to Unbound, median",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(blocky_request_duration_seconds_bucket{reason=\"RESOLVED\"}[5m])))",
          "legendFormat": "Blocky to Unbound, 95th percentile",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "unbound_recursion_time_seconds_avg",
          "legendFormat": "Unbound recursion, average",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ],
      "description": "Lookups answered by asking upstream, not from a cache or a list.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DNSSEC failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(unbound_answers_bogus[5m])",
          "legendFormat": "bogus answers per 5 minutes",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "description": "Answers Unbound refused because a DNSSEC signature did not validate.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "List sizes by group",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (group) (blocky_denylist_cache_entries)",
          "legendFormat": "{{group}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "description": "Names on each blocklist group.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Busiest devices",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dns-querylog"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "select client_name as \"Device\", count(*) as \"Lookups\" from log_entries where $__timeFilter(request_ts) group by 1 order by 2 desc limit 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dns-querylog"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top blocked names",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dns-querylog"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "select question_name as \"Name\", count(*) as \"Blocks\" from log_entries where $__timeFilter(request_ts) and response_type = 'BLOCKED' group by 1 order by 2 desc limit 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dns-querylog"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Device: lookups",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dns-querylog"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "select request_ts as \"Time\", question_name as \"Name\", question_type as \"Type\", response_type as \"Result\", answer as \"Answer\" from log_entries where $__timeFilter(request_ts) and client_name = '${client}' order by request_ts desc limit 500",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dns-querylog"
          },
          "refId": "A"
        }
      ],
      "description": "Choose the device with the Device drop-down at the top."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Device: blocks",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dns-querylog"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "select request_ts as \"Time\", question_name as \"Name\", reason as \"Why\" from log_entries where $__timeFilter(request_ts) and client_name = '${client}' and response_type = 'BLOCKED' order by request_ts desc limit 500",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dns-querylog"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "New names in the last day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dns-querylog"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "select question_name as \"Name\", min(request_ts) as \"First seen\", count(*) as \"Lookups\", string_agg(distinct client_name, ', ') as \"Devices\" from log_entries group by question_name having min(request_ts) > now() - interval '1 day' order by 2 desc limit 200",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dns-querylog"
          },
          "refId": "A"
        }
      ],
      "description": "Names first looked up within the last day and never before in the retained log (14 days). Often the first sign of something suspicious."
    }
  ]
}
